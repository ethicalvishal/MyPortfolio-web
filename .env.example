# Copy this file to ".env" and fill in real values.
# ".env" is already in .gitignore — it will never be committed.

DJANGO_SECRET_KEY=replace-this-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,vishalportfolio.com

# Leave DJANGO_DB_ENGINE unset (or remove the line) to use SQLite — zero setup.
# Set it to "mysql" and fill in the rest below to use MySQL instead.
# DJANGO_DB_ENGINE=mysql
# DJANGO_DB_NAME=portfolio
# DJANGO_DB_USER=root
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=3306
